<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>isl</string>
	</array>
	<key>foldingStartMarker</key>
	<string>(?ix) ^\s*( event\s+\w+ | sub\s+\w+ | if\b.* | for\b.* | forever\b | while\b.* | startprint\w* )</string>
	<key>foldingStopMarker</key>
	<string>(?i)^\s*end(event|sub|if|for|while|print\w*)\b</string>
	<key>name</key>
	<string>ISL</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>begin</key>
			<string>//</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.comment.isl</string>
				</dict>
			</dict>
			<key>end</key>
			<string>$\n?</string>
			<key>name</key>
			<string>comment.line.double-slash.isl</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>name</key>
			<string>string.quoted.double.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\bevent\s+(?:inq|tmed)\s*:\s*(?:\d+|\*)(?:[ \t]+//.*)?</string>
			<key>name</key>
			<string>entity.name.function.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\bevent\s+(?:rxmsg\s*:\s*[\w*]+|[A-Za-z_]\w*)</string>
			<key>name</key>
			<string>entity.name.function.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\bsub\s+\w+</string>
			<key>name</key>
			<string>entity.name.function.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\b(startprintwithstatus|continueoncancel|exitwitherror|endprintnoff|exitcontinue|exitoncancel|endprintff|exitcancel|startprint|endevent|endprint|endwhile|forever|elseif|endfor|endsub|return|break|endif|while|call|else|for|if|to)\b</string>
			<key>name</key>
			<string>keyword.control.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\b(and|or|not)\b</string>
			<key>name</key>
			<string>keyword.operator.word.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\b(var|ref)\b</string>
			<key>name</key>
			<string>storage.type.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\$\d+|(?i)\b[AN]\d+\b</string>
			<key>name</key>
			<string>storage.modifier.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>@\w+</string>
			<key>name</key>
			<string>variable.other.sysvar.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b\d+(\.\d+)?\b</string>
			<key>name</key>
			<string>constant.numeric.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?i)\b(one_time_auto_discounts|useunfiltereddetail|windowinputwithsave|displaytouchscreen|windoweditwithsave|display_rear_area|usefiltereddetail|discardglobalvar|windowscrolldown|displayreararea|getenterorclear|loaddbkybdmacro|retainglobalvar|usecompatformat|clearkybdmacro|displayinverse|displaymsinput|getmaxdiscount|setsignonright|useisltimeouts|usestdtimeouts|waitforconfirm|windowscrollup|clearreararea|dllcall_cdecl|loadkybdmacro|setsignonleft|clearchkinfo|displayinput|displayislts|errormessage|formatbuffer|regidleevent|setisltskeyx|useislformat|waitforclear|waitforenter|waitforrxmsg|infomessage|listdisplay|loadmaginfo|savechkinfo|saverefinfo|setisltskey|touchscreen|windowclear|windowclose|windowinput|cleararray|clearchkid|clearislts|editdetail|voiddetail|windowedit|arraysize|errorbeep|fwritebfr|keynumber|listinput|listprint|lowercase|makeascii|printline|setstring|test_dsvc|tointeger|uppercase|freadbfr|fwriteln|getrxmsg|inputkey|linefeed|makekeys|display|dllcall|dllfree|dllload|formatq|freadln|include|keytype|prorate|varsize|fclose|format|fwrite|gethex|msleep|prompt|splitq|system|window|debug|fopen|fread|fseek|ftell|input|instr|rxmsg|split|txmsg|beep|feof|trim|abs|asc|bit|chr|env|key|len|mid)\b</string>
			<key>name</key>
			<string>support.function.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\\\s*$</string>
			<key>name</key>
			<string>punctuation.separator.continuation.isl</string>
		</dict>
		<dict>
			<key>match</key>
			<string>&lt;&gt;|&lt;=|&gt;=|[-+*/%=&lt;&gt;]</string>
			<key>name</key>
			<string>keyword.operator.isl</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.isl</string>
	<key>uuid</key>
	<string>1B459BD3-7DE7-44BC-B50A-C433B9A5260E</string>
</dict>
</plist>
